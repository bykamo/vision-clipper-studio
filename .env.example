# VisionClipper Studio Environment Variables

# AI Provider Endpoint (e.g., 9Router, OpenRouter, OpenAI)
# NOTE: the API key must belong to the SAME gateway as this endpoint,
# otherwise every request fails with 401 Invalid API key.
ROUTER_API_ENDPOINT=https://api.example.com/v1

# Primary LLM model name (must exist in GET {endpoint}/models for your key)
ROUTER_LLM_MODEL=gemini-3.8-flash

# Optional: comma-separated fallback models tried when the primary fails
# ROUTER_FALLBACK_MODELS=gemini-3.8-flash,deepseek-v4.1-flash,mimo-v2.6.flash

# Your API Key for the endpoint
ROUTER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq API Key for Ultra-Fast Cloud Whisper Transcription (Free at https://console.groq.com)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
