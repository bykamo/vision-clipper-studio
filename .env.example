# VisionClipper Studio Environment Variables

# AI Provider Endpoint (e.g., 9Router, OpenRouter, OpenAI)
# NOTE: the API key must belong to the SAME gateway as this endpoint,
# otherwise every request fails with 401 Invalid API key.
ROUTER_API_ENDPOINT=https://api.example.com/v1

# Primary LLM model name (must exist in GET {endpoint}/models for your key)
ROUTER_LLM_MODEL=gemini-3.8-flash

# Optional: comma-separated fallback models tried when the primary fails
# ROUTER_FALLBACK_MODELS=gemini-3.8-flash,deepseek-v4.1-flash,mimo-v2.6.flash

# Your API Key for the endpoint
ROUTER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq API Key for Ultra-Fast Cloud Whisper Transcription (Free at https://console.groq.com)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
# VPS / REMOTE ONLY — leave these COMMENTED OUT on macOS and Windows.
#
# VC_COOKIE_SECURE=1 makes the session cookie HTTPS-only. If it ends up in a
# .env that is copied to a laptop, the browser rejects the cookie over
# http://localhost and EVERY /api/* request returns 403.
# Set it from the systemd unit instead (see deploy/visionclipper.service).
# ─────────────────────────────────────────────────────────────────────────────

# Interface to bind. 127.0.0.1 = loopback only (default, safest).
# Use 0.0.0.0 only behind a reverse proxy such as deploy/nginx.conf.sample.
# VC_HOST=127.0.0.1

# Extra Host/Origin allowlist, comma separated. Needed when the dashboard is
# reached through a domain or a public IP (loopback + private ranges already work).
# VC_ALLOWED_HOSTS=clipper.example.com

# HTTPS-only session cookie. Enable only when served over TLS.
# VC_COOKIE_SECURE=1

# Cap the download resolution (default 1080). Lower = less CPU/bandwidth.
# VC_MAX_DOWNLOAD_HEIGHT=1080
